APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ─── B2B Onboarding / Multi-tenant ─────────────────────────
# The central domain of the platform. This is the SINGLE source of truth for
# the base domain: tenant store subdomains are generated under it (e.g.
# `albaraka` -> `albaraka.superx-erp.com`) and it is also fed into
# `config('tenancy.central_domains')`. Set it in EVERY deployed environment —
# leaving it unset makes the config fallback decide production behaviour.
# MUST be a bare host: no scheme, port or path.
CENTRAL_DOMAIN=superx-erp.com

# Legacy alias, read only when CENTRAL_DOMAIN is absent. Safe to leave unset.
# SUPERX_TENANT_DOMAIN=superx.com

# Frontend origin used to build tenant store URLs (store, activation links,
# login). LEAVE EMPTY in production: URLs are then derived from CENTRAL_DOMAIN
# over https. Set it in local development to the Next.js origin, and the
# dev-only `{subdomain}.localhost:3000` tenant URLs are used.
# SUPERX_FRONTEND_URL=http://localhost:3000

# Force the `{subdomain}.localhost` URL shape on/off regardless of APP_ENV.
# Defaults to true only for APP_ENV=local/testing, and is additionally
# ignored unless SUPERX_FRONTEND_URL is a loopback host — so a production
# deploy can never surface localhost links.
# SUPERX_TENANT_DEV_SUBDOMAINS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ─── SMS Provider ─────────────────────────────────────────
# Choices: twilio | taqnyat | null (no-op fallback)
SMS_PROVIDER=null

# Twilio (global SMS — sign up at https://console.twilio.com)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=

# Taqnyat (Jordan/GCC SMS — sign up at https://taqnyat.sa)
TAQNYAT_TOKEN=
TAQNYAT_SENDER_NAME=

# ─── WhatsApp Provider ────────────────────────────────────
# Choices: bus (Meta WhatsApp Business Cloud) | ultramsg | null (no-op fallback)
WHATSAPP_PROVIDER=null

# Meta WhatsApp Business Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# UltraMsg (unofficial WhatsApp gateway — https://ultramsg.com)
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
